{
  "name": "custos-portal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "pnpm gen:api && next dev",
    "build": "pnpm gen:api && next build",
    "start": "next start",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "pnpm gen:api && tsc --noEmit",
    "test": "pnpm gen:api && vitest run --passWithNoTests",
    "test:watch": "pnpm gen:api && vitest",
    "test:e2e": "playwright test",
    "clean": "rm -rf .next dist coverage",
    "gen:api": "tsx scripts/gen-api.mts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@casl/ability": "^7.0.0",
    "@casl/react": "^7.0.0",
    "@hookform/resolvers": "^6.0.0",
    "@tanstack/react-query": "^5.100.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "msw": "^2.14.6",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.76.0",
    "react-json-view-lite": "^2.5.0",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "axe-core": "^4.11.4",
    "jsdom": "^30.1.3",
    "shadcn": "^4.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "msw": {
    "workerDirectory": ["public"]
  }
}
