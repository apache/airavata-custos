# SELinux type enforcement policy: allow sshd to reach the OIDC provider
# and LDAP.
#
# Problem: pam_oauth2_device runs inside sshd and uses libcurl for the
# device flow (HTTPS, port 443) plus a direct LDAP query (port 636).
# SELinux's default sshd policy does not permit those outbound TCP
# connections. Without this module, auth silently falls through to
# password-auth.
#
# On OpenSSH 9.8+ (Rocky/RHEL 10) authentication runs in the split
# sshd-session process under its own sshd_session_t type, so that type
# needs the same allows. It does not exist on RHEL 9, hence the
# optional block.
#
# Discovered from AVC denial:
#   avc: denied { name_connect } for comm="sshd" dest=443
#   scontext=system_u:system_r:sshd_t:s0
#   tcontext=system_u:object_r:http_port_t:s0
#   tclass=tcp_socket
#
# Build:
#   checkmodule -M -m -o pam_oauth2_sshd.mod pam_oauth2_sshd.te
#   semodule_package -o pam_oauth2_sshd.pp -m pam_oauth2_sshd.mod
#   semodule -i pam_oauth2_sshd.pp

module pam_oauth2_sshd 2.0;

require {
    type sshd_t;
    type http_port_t;
    type ldap_port_t;
    class tcp_socket name_connect;
}

#============= sshd_t ==============
allow sshd_t http_port_t:tcp_socket name_connect;
allow sshd_t ldap_port_t:tcp_socket name_connect;

#============= sshd_session_t (OpenSSH 9.8+ split sshd) ==============
optional {
    require {
        type sshd_session_t;
    }
    allow sshd_session_t http_port_t:tcp_socket name_connect;
    allow sshd_session_t ldap_port_t:tcp_socket name_connect;
}
