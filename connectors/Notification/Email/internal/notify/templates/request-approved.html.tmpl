{{define "preheader"}}Sign in to the portal to choose your username and accept the user agreement.{{end}}
{{define "status"}}<td class="pill-ok" style="padding:4px 10px; border:1px solid #9adbb4; border-radius:999px; background-color:#eefbf2; color:#157347; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif; font-size:13px; line-height:18px; font-weight:600;">&#10003;&nbsp;Approved</td>{{end}}
{{define "footer"}}You are receiving this because an account on {{.SiteName}} was requested for you. This is an automated message.{{end}}
{{define "body"}}
<h1 class="h1 t-strong" style="margin:0 0 16px 0; font-size:24px; line-height:32px; font-weight:700; color:#111111;">Your account is approved</h1>
<p class="t-body" style="margin:0 0 16px 0; font-size:16px; line-height:26px; color:#404040;">Hi{{if .FirstName}} {{.FirstName}}{{end}},</p>
<p class="t-body" style="margin:0 0 16px 0; font-size:16px; line-height:26px; color:#404040;">Sign in to the portal to choose your username and accept the user agreement. Your cluster account is set up right after.</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 16px 0;">
<tr>
<td class="t-muted rule" width="40%" style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif; padding:10px 0; border-top:1px solid #e0e7ed; font-size:14px; line-height:20px; color:#4b5563; vertical-align:top;">Suggested username</td>
<td class="t-strong rule" style="font-family:ui-monospace,SFMono-Regular,'SF Mono',Menlo,Consolas,'Liberation Mono',monospace; padding:10px 0; border-top:1px solid #e0e7ed; font-size:15px; line-height:20px; font-weight:600; color:#111111; vertical-align:top;">{{.Username}}</td>
</tr>
</table>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:8px 0 16px 0;">
<tr>
<td class="btn-td" align="center" bgcolor="#45c6e8" style="border-radius:8px; background-color:#45c6e8; mso-padding-alt:14px 28px;">
<a class="btn-a" href="{{.PortalURL}}" style="display:inline-block; padding:14px 28px; min-height:20px; border:1px solid #45c6e8; border-radius:8px; background-color:#45c6e8; color:#0a0d12; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif; font-size:16px; line-height:20px; font-weight:700; text-decoration:none;">Sign in to {{.SiteName}}</a>
</td>
</tr>
</table>
{{end}}
