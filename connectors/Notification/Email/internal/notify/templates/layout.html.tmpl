{{/* Shared shell. Each email defines preheader, status, body, and footer. */}}
{{define "layout"}}<!doctype html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="x-apple-disable-message-reformatting">
<meta name="format-detection" content="telephone=no, date=no, address=no, email=no, url=no">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>{{.Subject}}</title>
<style>
  :root { color-scheme: light dark; supported-color-schemes: light dark; }
  body { margin:0 !important; padding:0 !important; width:100% !important; }
  a[x-apple-data-detectors] { color:inherit !important; text-decoration:none !important; font-size:inherit !important; font-family:inherit !important; font-weight:inherit !important; line-height:inherit !important; }
  u + #body a { color:inherit; text-decoration:none; font-size:inherit; font-family:inherit; font-weight:inherit; line-height:inherit; }
  .link { color:#b35f00 !important; text-decoration:underline !important; }
  @media (max-width:620px) {
    .card-pad { padding-left:20px !important; padding-right:20px !important; }
    .outer-pad { padding:16px 8px !important; }
    .h1 { font-size:22px !important; }
  }
  @media (prefers-color-scheme: dark) {
    .bg-page { background-color:#111111 !important; }
    .bg-card { background-color:#262626 !important; border-color:#404040 !important; }
    .bg-foot { background-color:#1c1c1c !important; border-color:#404040 !important; }
    .bg-code { background-color:#111111 !important; border-color:#404040 !important; }
    .rule { border-color:#404040 !important; }
    .t-strong { color:#f4f5f7 !important; }
    .t-body { color:#d4d4d4 !important; }
    .t-muted { color:#9aa1ae !important; }
    .link { color:#ffa726 !important; }
    .btn-td { background-color:#ffa726 !important; }
    .btn-a { background-color:#ffa726 !important; border-color:#ffa726 !important; color:#111111 !important; }
    .pill-info { background-color:#1e3a5f !important; color:#d2e1f1 !important; border-color:#4d86c9 !important; }
    .pill-ok { background-color:#14381f !important; color:#bbf7d0 !important; border-color:#16a34a !important; }
    .pill-err { background-color:#4a1717 !important; color:#fecaca !important; border-color:#dc2626 !important; }
    .quote { border-color:#6b7280 !important; }
  }
  [data-ogsb] .bg-page { background-color:#111111 !important; }
  [data-ogsb] .bg-card { background-color:#262626 !important; }
  [data-ogsb] .bg-foot { background-color:#1c1c1c !important; }
  [data-ogsb] .bg-code { background-color:#111111 !important; }
  [data-ogsc] .t-strong { color:#f4f5f7 !important; }
  [data-ogsc] .t-body { color:#d4d4d4 !important; }
  [data-ogsc] .t-muted { color:#9aa1ae !important; }
  [data-ogsc] .link { color:#ffa726 !important; }
  [data-ogsb] .btn-td, [data-ogsb] .btn-a { background-color:#ffa726 !important; }
  [data-ogsc] .btn-a { color:#111111 !important; }
</style>
</head>
<body id="body" class="bg-page" style="margin:0; padding:0; width:100%; background-color:#f4f5f7; -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%;">
{{/* The filler stops the body text showing up in the inbox preview. */}}
<div style="display:none; max-height:0; max-width:0; overflow:hidden; opacity:0; mso-hide:all; font-size:1px; line-height:1px; color:#f4f5f7;">{{template "preheader" .}}&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="bg-page" style="background-color:#f4f5f7;">
<tr>
<td align="center" class="outer-pad" style="padding:32px 16px;">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" class="bg-card" style="width:100%; max-width:600px; background-color:#ffffff; border:1px solid #e5e7eb; border-radius:12px; border-collapse:separate;">
<tr><td height="4" style="height:4px; line-height:4px; font-size:4px; background-color:#fe8c00; border-radius:12px 12px 0 0;">&nbsp;</td></tr>
{{/* The site name is text so the header still reads when images are off. */}}
<tr>
<td class="card-pad" style="padding:24px 32px 0 32px;">
<table role="presentation" cellpadding="0" cellspacing="0" border="0">
<tr>
{{if .LogoURL}}<td width="28" valign="middle" style="padding-right:10px;"><img src="{{.LogoURL}}" width="28" height="28" alt="" style="display:block; width:28px; height:28px; border:0; outline:none;"></td>{{end}}
<td valign="middle" class="t-strong" style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif; font-size:17px; line-height:24px; font-weight:700; color:#111111;">{{.SiteName}}</td>
</tr>
</table>
</td>
</tr>
<tr>
<td class="card-pad" style="padding:28px 32px 0 32px;">
<table role="presentation" cellpadding="0" cellspacing="0" border="0">
<tr>
{{template "status" .}}
</tr>
</table>
</td>
</tr>
<tr>
<td class="card-pad" style="padding:16px 32px 8px 32px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
{{template "body" .}}
</td>
</tr>
<tr>
<td class="card-pad bg-foot rule" style="padding:20px 32px; background-color:#f9fafb; border-top:1px solid #e5e7eb; border-radius:0 0 12px 12px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
<p class="t-muted" style="margin:0 0 8px 0; font-size:13px; line-height:20px; color:#4b5563;">{{template "footer" .}}</p>
<p class="t-muted" style="margin:0; font-size:13px; line-height:20px; color:#4b5563;">Questions? Write to <a class="link" href="mailto:{{.SupportEmail}}" style="color:#b35f00; text-decoration:underline;">{{.SupportEmail}}</a>.</p>
</td>
</tr>
</table>
</td>
</tr>
</table>
</body>
</html>
{{end}}
